<!DOCTYPE html>
<html lang="hu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport"
        content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="referrer" content="no-referrer">
  <meta name="theme-color" content="#000000">
  <title>Neked ❤️</title>

  <style>
    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: #000;
      font-family: system-ui, sans-serif;
    }

    body {
      display: grid;
      place-items: center;
    }

    main {
      position: relative;
      width: min(100vw, 56.25dvh);
      aspect-ratio: 9 / 16;
    }

    video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
    }

    #start {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 18px;
      border: none;
      color: white;
      background: rgba(0, 0, 0, 0.2);
      font: 600 18px system-ui, sans-serif;
      cursor: pointer;
    }

    #start[hidden] { display: none; }

    .play {
      display: grid;
      place-items: center;
      width: 80px;
      height: 80px;
      padding-left: 5px;
      border: 1px solid #ffffff80;
      border-radius: 50%;
      background: #00000080;
      font-size: 32px;
    }

    #start:focus-visible {
      outline: 3px solid white;
      outline-offset: -5px;
    }

    #error {
      position: absolute;
      inset: 0;
      padding: 32px;
      color: white;
      background: #111;
      text-align: center;
    }

    a { color: white; }
  </style>
</head>
<body>
  <main aria-label="Videólejátszó">
    <video id="video" controls playsinline preload="metadata">
      <source src="./video.mp4" type="video/mp4">
      A böngésződ nem támogatja a videólejátszást.
    </video>

    <button id="start" type="button"
            aria-label="Videó indítása hanggal">
      <span class="play" aria-hidden="true">▶</span>
      <span id="label">Egy érintés, és indul ❤️</span>
    </button>

    <div id="error" role="alert" hidden>
      <p>A videót nem sikerült betölteni.</p>
      <a href="./video.mp4">Videó megnyitása</a>
    </div>
  </main>

  <script>
    const video = document.getElementById("video");
    const start = document.getElementById("start");
    const label = document.getElementById("label");
    const error = document.getElementById("error");

    start.addEventListener("click", async () => {
      video.muted = false;

      if (video.ended) video.currentTime = 0;

      try {
        await video.play();
        start.hidden = true;
      } catch {
        start.hidden = true;
        video.controls = true;
      }
    });

    video.addEventListener("play", () => {
      start.hidden = true;
    });

    video.addEventListener("ended", () => {
      label.textContent = "Még egyszer ❤️";
      start.hidden = false;
    });

    function showError() {
      start.hidden = true;
      error.hidden = false;
    }

    video.addEventListener("error", showError);
    video.querySelector("source").addEventListener("error", showError);
  </script>
</body>
</html>
